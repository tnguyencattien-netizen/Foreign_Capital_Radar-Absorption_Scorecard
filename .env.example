# ============================================================
# CẤU HÌNH MẪU CHO FOREIGN CAPITAL RADAR (SSI FASTCONNECT DATA)
# ============================================================
SSI_API_BASE_URL = https://fc-data.ssi.com.vn/
SSI_STREAM_URL = https://fc-data.ssi.com.vn/
SSI_AUTH_TYPE=Bearer
SSI_CONSUMER_ID = your_ssi_consumer_id_here
SSI_CONSUMER_SECRET = your_ssi_consumer_secret_here

DB_PATH=data/foreign_radar.db
WATCHLIST_INDEX=VN30
POLL_INTERVAL_SECONDS = 45
TIMEZONE=Asia/Ho_Chi_Minh
